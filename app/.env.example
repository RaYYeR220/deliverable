# Server only. Read in route handlers; never sent to the browser. Any mainnet RPC that
# allows getMultipleAccounts. Preview, Replay's market prices and the basis read it.
SOLANA_RPC_URL=

# Server only, and needed when the program id below points at a devnet deployment:
# Live then reads that program's own accounts from devnet. Give either a full devnet
# endpoint, or a Helius key from which the devnet endpoint is built on the server.
# Neither the url nor the key ever reaches the browser.
SOLANA_DEVNET_RPC_URL=
HELIUS_API_KEY=

# Public. Leave the program id empty until the program is deployed: the instrument then
# runs the gate in Preview. Setting it switches the instrument to Live against that id.
NEXT_PUBLIC_DELIVERABLE_PROGRAM_ID=
# mainnet-beta | devnet | testnet. Used for explorer links to program accounts. Set it
# to devnet together with the program id above to have Live read the devnet deployment:
# its SecurityState, the price and multiplier it recorded, and the refusal it wrote.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Optional. Shown in the landing footer when set.
NEXT_PUBLIC_REPOSITORY_URL=
