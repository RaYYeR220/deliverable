# Server only. Read in route handlers; never sent to the browser. Any mainnet RPC that
# allows getMultipleAccounts (and getProgramAccounts once the program is deployed).
SOLANA_RPC_URL=

# Public. Leave the program id empty until the program is deployed: the instrument then
# runs the gate in Preview. Setting it switches the instrument to Live against that id.
NEXT_PUBLIC_DELIVERABLE_PROGRAM_ID=
# mainnet-beta | devnet | testnet. Used for explorer links to program accounts.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Optional. Shown in the landing footer when set.
NEXT_PUBLIC_REPOSITORY_URL=
